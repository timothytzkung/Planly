# Local Dockerized MongoDB (backend running on the HOST, e.g. `task server-up`).
# Root user authenticates against the "admin" database, hence authSource=admin.
MONGO_WQB_URI=mongodb://admin:change-me@localhost:27017/wqb?authSource=admin

# When the backend itself runs INSIDE docker-compose, use the service hostname:
# MONGO_WQB_URI=mongodb://admin:change-me@mongodb:27017/wqb?authSource=admin

# Legacy MongoDB Atlas connection (kept for reference / data migration):
# MONGO_WQB_URI=mongodb+srv://<user_name>:<password>@cluster0.xsec5jy.mongodb.net/wqb?appName=Cluster0

JWT_SECRET=change-me
