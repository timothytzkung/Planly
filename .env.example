## MongoDB (root credentials for the Dockerized mongod)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

## Mongo Express (dashboarding at http://localhost:8081)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=change-me

## Backend (only needed when running the "backend" service via docker-compose)
JWT_SECRET=change-me
